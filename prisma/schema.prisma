generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  plan       Plan
  created_at DateTime @default(now())

  trialStartedAt DateTime @default(now())
  trialEndsAt    DateTime

  subscriptionPurchaseToken String?
  subscriptionExpiresAt     DateTime?

  @@map("users")
}

enum Plan {
  FREE
  TRIAL
  PREMIUM
}
