# Postgres (dev via docker-compose.dev.yml: porta 5433)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/user-service-db?schema=public"
# Deve ser idêntico ao do finance-service
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
KAFKA_URL="localhost:29092"
# Google Play (opcional em dev; necessário para validar assinaturas)
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_PACKAGE_NAME=
GOOGLE_PLAY_PUBSUB_TOKEN=
# Logs: nível (debug, info, warn, error) e formato (json ou pretty, colorido)
LOG_LEVEL=info
LOG_FORMAT=pretty
